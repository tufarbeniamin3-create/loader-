name: Build TextureLoader EXE

on:
  workflow_dispatch:
  push:
    branches:
      - exe

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        working-directory: TextureLoader
        run: npm install

      - name: Build the Windows executable
        working-directory: TextureLoader
        run: npm run build

      - name: Upload the EXE artifact
        uses: actions/upload-artifact@v4
        with:
          name: TextureLoader-exe
          path: TextureLoader/dist/*.exe
          if-no-files-found: error
